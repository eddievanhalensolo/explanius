# Explanius configuration. Copy to .env and fill in what you need.
# In production every secret below comes from Secret Manager instead.

# === LLM provider: gemini | claude | openai | openrouter ===
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model overrides (defaults live in src/config.py)
CLAUDE_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-3.1-pro-preview
# OPENAI_MODEL=gpt-5.4
# OPENROUTER_MODEL=openrouter/fusion

# === Email (SMTP; Gmail needs an App Password) ===
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# === Storage ===
# Local files under DATA_DIR, or a GCS bucket when USE_CLOUD_STORAGE=true
DATA_DIR=data
USE_CLOUD_STORAGE=false
GCP_PROJECT_ID=
GCS_BUCKET_NAME=

# === Generator service (src/server.py) ===
# /inbound: shared token sent by your mail forwarder + allowed sender addresses
INBOUND_TOKEN=
ALLOWED_SENDERS=you@example.com
# /run, /generate-suggestion: Google ID-token callers. Both lists empty = all rejected.
ALLOWED_INVOKERS=scheduler-sa@your-project.iam.gserviceaccount.com
ALLOWED_AUDIENCES=https://your-generator-url.run.app

# === Web admin (src/web_admin/app.py) — refuses to start without these ===
FLASK_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
MAIN_SERVICE_URL=https://your-generator-url.run.app
